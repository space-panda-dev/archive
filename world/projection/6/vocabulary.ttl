# The Archive terms World projection 6 emits. Inherited terms (PROV-O, Web
# Annotation, SKOS, Dublin Core, Activity Streams, FOAF) keep their own
# meaning, narrowed as ADR 0012 says; the shapes files say how each is used.
# Most terms come from the core context or a contract's context fragment in
# the archive's specification; World mints `credit`, `performance_kind`,
# `audio_stream`, `projection_version`, `WorldProjection`, and
# `world-projection-6`.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix arch: <urn:uuid:3e8b29f8-70c9-403e-bb4c-2280d59eca7f#> .

arch:world-projection-6 a owl:Ontology ;
  rdfs:label "World projection 6" ;
  rdfs:comment "The projection a World store declares with dcterms:conformsTo when it was built by projection version 6." .

# Classes

arch:WorldProjection a rdfs:Class ; rdfs:comment "A World projection of one archive, <{archive}#world>." .
arch:Artifact a rdfs:Class ; rdfs:comment "A record revision of shape artifact: an object whose bytes the archive keeps. Not prov:Entity's meaning (ADR 0012)." .
arch:Entity a rdfs:Class ; rdfs:comment "A record revision of shape entity: a durable subject the operator asserts. arch:Entity is not prov:Entity." .
arch:Claim a rdfs:Class ; rdfs:comment "A record revision of shape claim: a typed statement about other things." .
arch:Assessment a rdfs:Class ; rdfs:comment "A record revision of shape assessment: a judgment of an exact claim revision." .

# The record envelope (core context)

arch:shape a rdf:Property ; rdfs:comment "The record's shape class." .
arch:revision_id a rdf:Property ; rdfs:comment "The revision identifier, sha256 of the canonical draft." .
arch:object_id a rdf:Property ; rdfs:comment "The object the revision describes." .
arch:payload a rdf:Property ; rdfs:comment "The record's payload, as rdf:JSON." .
arch:refs a rdf:Property ; rdfs:comment "Links a revision to the reified statement of one of its references." .
arch:supersedes a rdf:Property ; rdfs:comment "Links a revision to its supersession statement, and, as a role, to the revision it supersedes." .
arch:source a rdf:Property ; rdfs:comment "Imported source identity, as rdf:JSON; never Archive identity." .
arch:contracts a rdf:Property ; rdfs:comment "The record's contract citations, as rdf:JSON." .
arch:role a rdf:Property ; rdfs:comment "A reference statement's role predicate." .
arch:id a rdf:Property ; rdfs:comment "A reference statement's target object identifier, as a string." .
arch:spec a rdf:Property ; rdfs:comment "The archive's specification, archive/<version>." .
arch:version a rdf:Property ; rdfs:comment "A version string: a contract bundle's version in the context graph; in a claim graph, the version of a method or of a program a run reports." .

# Projection metadata (World)

arch:projection_version a rdf:Property ; rdfs:comment "The projection version that built the graph, an integer." .

# Reference roles (contract context fragments of specification 0.0.7)

arch:alignment a rdf:Property ; rdfs:comment "audio_selection 2: a capture_alignment claim the selection relied on." .
arch:alignment_aligned a rdf:Property ; rdfs:comment "capture_alignment 1: the aligned Artifact revision." .
arch:appoints a rdf:Property ; rdfs:comment "operator_initialization 1: the appointed operator." .
arch:assessment_of a rdf:Property ; rdfs:comment "An assessment's judged claim revision." .
arch:author a rdf:Property ; rdfs:comment "A transition's author." .
arch:authorizer a rdf:Property ; rdfs:comment "A transition's authorizer." .
arch:covers a rdf:Property ; rdfs:comment "publication_approval 1: a claim the approval covers." .
arch:credited_artist a rdf:Property ; rdfs:comment "artist_credit 1: a credited person or organisation." .
arch:dependent_destroy a rdf:Property ; rdfs:comment "destroy: a dependent Artifact destroyed with the target." .
arch:dependent_source_gone a rdf:Property ; rdfs:comment "destroy: a dependent whose source is gone." .
arch:destroys a rdf:Property ; rdfs:comment "destroy: the Artifact whose content is destroyed." .
arch:external_survivor a rdf:Property ; rdfs:comment "destroy: evidence of a copy the archive cannot remove." .
arch:match_corpus a rdf:Property ; rdfs:comment "work_match: an occurrence in the compared corpus." .
arch:measured_stream a rdf:Property ; rdfs:comment "span_suggestions 1: the audio_stream claim revision the spans were measured against." .
arch:migration_source a rdf:Property ; rdfs:comment "Migration translations: the frozen source bundle Artifact." .
arch:parameters a rdf:Property ; rdfs:comment "work_match, derivation_run 1: the Artifact revision holding the method's parameters as canonical JSON." .
arch:performance a rdf:Property ; rdfs:comment "performance_work: the performance or occurrence claim; work_match: the compared occurrence." .
arch:piece a rdf:Property ; rdfs:comment "audio_selection: an Artifact revision a span is cut from; in a claim graph, a version 1 span." .
arch:reference a rdf:Property ; rdfs:comment "capture_alignment 1: the reference Artifact revision." .
arch:retires a rdf:Property ; rdfs:comment "retire: the retired object's revision." .
arch:selection a rdf:Property ; rdfs:comment "A selection claim revision a fact is about, or an occurrence's selection." .
arch:session a rdf:Property ; rdfs:comment "session_parts 1: the recording_session Entity revision." .
arch:session_part a rdf:Property ; rdfs:comment "session_parts 1: a part; in a claim graph, the ordered part node." .
arch:transition_predecessor a rdf:Property ; rdfs:comment "A transition's immediately preceding transition in one batch." .
arch:translated_assessment a rdf:Property ; rdfs:comment "migration translation 1: a translated assessment." .
arch:withdraws a rdf:Property ; rdfs:comment "publication_withdrawal 1: the withdrawn approval." .
arch:work a rdf:Property ; rdfs:comment "A musical_work Entity revision, or object for performance_work 1." .

# What a claim asserts (claim graphs)

arch:tracks a rdf:Property ; rdfs:comment "audio_selection 2: one track node per simultaneous source." .
arch:pieces a rdf:Property ; rdfs:comment "audio_selection 2: one span node of a track." .
arch:start_sample a rdf:Property ; rdfs:comment "A span's first sample, inclusive." .
arch:end_sample a rdf:Property ; rdfs:comment "A span's end sample, exclusive." .
arch:sample_rate a rdf:Property ; rdfs:comment "The Artifact's sample rate, in Hz." .
arch:reference_rate a rdf:Property ; rdfs:comment "capture_alignment 1: the reference's nominal sample rate." .
arch:aligned_rate a rdf:Property ; rdfs:comment "capture_alignment 1: the aligned recording's nominal sample rate." .
arch:max_error_samples a rdf:Property ; rdfs:comment "capture_alignment 1: the method's residual bound." .
arch:anchors a rdf:Property ; rdfs:comment "capture_alignment 1: one anchor node." .
arch:reference_sample a rdf:Property ; rdfs:comment "An anchor's reference sample." .
arch:aligned_sample a rdf:Property ; rdfs:comment "An anchor's aligned sample." .
arch:performance_kind a rdf:Property ; rdfs:comment "selection_kind 1: the selection's kind, a concept in the performance-kinds scheme. Minted by World." .
arch:credit a rdf:Property ; rdfs:comment "artist_credit 1: one ordered credit node. Minted by World." .
arch:verdict a rdf:Property ; rdfs:comment "judgment 1: affirmed, rejected, or withdrawn." .
arch:reason a rdf:Property ; rdfs:comment "judgment 1: the judgment's reason." .

# Derivation runs and what they make (specification 0.0.7, revision 3)

arch:method a rdf:Property ; rdfs:comment "derivation_run 1, work_match 2 and 3: the method node, with its dcterms:identifier and arch:version." .
arch:audio_stream a rdf:Property ; rdfs:comment "audio_stream 1: links the described Artifact revision to the claim's stream node. Minted by World." .
arch:stream_index a rdf:Property ; rdfs:comment "audio_stream 1: the stream's zero-based index in its container." .
arch:codec a rdf:Property ; rdfs:comment "audio_stream 1: the codec's name as the probing method reports it." .
arch:channel_count a rdf:Property ; rdfs:comment "audio_stream 1: the number of channels." .
arch:sample_count a rdf:Property ; rdfs:comment "audio_stream 1: the exact number of sample frames decoded at the stream's sample rate." .
arch:bits_per_sample a rdf:Property ; rdfs:comment "audio_stream 1: the PCM sample width, when the probe states it." .
arch:suggested_spans a rdf:Property ; rdfs:comment "span_suggestions 1: one suggested span node, in order." .
arch:span_class a rdf:Property ; rdfs:comment "span_suggestions 1: music, talk, quiet, or unknown." .
arch:score a rdf:Property ; rdfs:comment "work_match: the match score as xsd:decimal, meaningful only within its scale and direction." .
arch:score_scale a rdf:Property ; rdfs:comment "work_match: what the score measures." .
arch:score_direction a rdf:Property ; rdfs:comment "work_match: higher_is_closer or lower_is_closer." .

# Window matches (specification 0.0.8, revision 4)

arch:compared_suggestions a rdf:Property ; rdfs:comment "work_match 3: the span_suggestions claim whose window was compared." .
arch:window a rdf:Property ; rdfs:comment "work_match 3: the compared window node, with its start_sample, end_sample, and sample_rate. Minted by World." .

# Chord stacks, chord sequences, and meter layers, contributions and band membership
# (specification 0.0.9, revision 5). Every reading and credit stays its
# asserter's; chord names are computed views and are not terms here.

arch:analysed_audio a rdf:Property ; rdfs:comment "chord_stacks 1, meter_layers 1: audio analysed in place of the mix, such as a stem, sharing its timeline." .
arch:document_url a rdf:Property ; rdfs:comment "Where an outside document was retrieved from; never the evidence, which is the pinned Artifact." .
arch:document_alignment a rdf:Property ; rdfs:comment "How a document's positions were placed on the recording's samples: a node with its method and optional bound." .
arch:alignment_method a rdf:Property ; rdfs:comment "A document alignment's method: manual for a person's placement, otherwise the aligning method's identifier." .
arch:locator a rdf:Property ; rdfs:comment "A position in a document's own numbering, as a node with its bar and beat." .
arch:locator_bar a rdf:Property ; rdfs:comment "A locator's bar number in the document." .
arch:locator_beat a rdf:Property ; rdfs:comment "A locator's beat in its bar." .
arch:chord_spans a rdf:Property ; rdfs:comment "chord_stacks 1: one span node, in order." .
arch:part a rdf:Property ; rdfs:comment "chord_stacks 1: the part the stacks describe, as the asserter names it." .
arch:weight_scale a rdf:Property ; rdfs:comment "chord_stacks 1: what the claim's weights mean; weights compare only within their claim." .
arch:part_contribution a rdf:Property ; rdfs:comment "chord_stacks 1: the contribution saying whose part the stacks describe (ADR 0078)." .
arch:readings a rdf:Property ; rdfs:comment "chord_stacks 1: one reading node of a span, ranked by rdf:value." .
arch:bass a rdf:Property ; rdfs:comment "A stack's bass pitch class, 0 to 11, C = 0." .
arch:tones a rdf:Property ; rdfs:comment "A pitch class sounding above a stack's bass." .
arch:root a rdf:Property ; rdfs:comment "A stack's asserted root pitch class, which need not sound." .
arch:uncertain_tones a rdf:Property ; rdfs:comment "A group of uncertain pitch classes of a stack." .
arch:pitch_classes a rdf:Property ; rdfs:comment "One pitch class of an uncertain group." .
arch:present a rdf:Property ; rdfs:comment "exactly_one (one class of the group sounds) or maybe (one or none)." .
arch:voicing a rdf:Property ; rdfs:comment "One MIDI note of a stack's voicing; the lowest is the bass." .
arch:no_chord a rdf:Property ; rdfs:comment "true: the asserter states that no chord sounds, which differs from asserting nothing." .
arch:source_text a rdf:Property ; rdfs:comment "The source's own chord symbol, verbatim." .
arch:weight a rdf:Property ; rdfs:comment "A reading's weight on its claim's weight_scale, as xsd:decimal." .
arch:meter_layers a rdf:Property ; rdfs:comment "meter_layers 1: one layer node; layers are simultaneous and none is primary." .
arch:bars a rdf:Property ; rdfs:comment "meter_layers 1: one bar node of a layer, in order." .
arch:numerator a rdf:Property ; rdfs:comment "A bar's numerator." .
arch:denominator a rdf:Property ; rdfs:comment "A bar's or note value's denominator." .
arch:grouping a rdf:Property ; rdfs:comment "A bar's beat grouping in its usual notation, such as 2+2+3." .
arch:beat_samples a rdf:Property ; rdfs:comment "The sample of one counted beat of a bar." .
arch:metric_modulations a rdf:Property ; rdfs:comment "meter_layers 1: one metric modulation node." .
arch:modulated_layer a rdf:Property ; rdfs:comment "The layer a metric modulation is in." .
arch:modulated_bar a rdf:Property ; rdfs:comment "The bar a metric modulation starts. Minted by World." .
arch:before_note a rdf:Property ; rdfs:comment "The note value before a metric modulation." .
arch:after_note a rdf:Property ; rdfs:comment "The note value after a metric modulation." .
arch:dots a rdf:Property ; rdfs:comment "A note value's dots, 0 to 2." .
arch:modulation_kind a rdf:Property ; rdfs:comment "equation or regrouping. Minted by World, since kind is a core term." .
arch:pulse_before a rdf:Property ; rdfs:comment "A regrouping's felt pulse before it." .
arch:pulse_after a rdf:Property ; rdfs:comment "A regrouping's felt pulse after it." .
arch:layer_role a rdf:Property ; rdfs:comment "written (the meter as notated) or felt (a feel heard over it). Minted by World, since role is a core term." .
arch:downbeat_samples a rdf:Property ; rdfs:comment "A beat-only layer's beat that the asserter marks as a downbeat." .
arch:beat_unit a rdf:Property ; rdfs:comment "A beat-only layer's beat note value, when the asserter states it." .
arch:hold_rule a rdf:Property ; rdfs:comment "chord_stacks 1: how the asserter held spans whose end is held." .
arch:span_end a rdf:Property ; rdfs:comment "asserted, or held: the asserter held the chord by its hold_rule." .
arch:sequence_entry a rdf:Property ; rdfs:comment "The entry of the placed chord sequence a span was placed from." .
arch:placed_sequence a rdf:Property ; rdfs:comment "chord_stacks 1: the chord sequence an alignment placed on the recording." .
arch:corrects a rdf:Property ; rdfs:comment "A chord claim this one corrects; it replaces nothing." .
arch:sequence_entries a rdf:Property ; rdfs:comment "chord_sequence 1: one entry node, in written order." .
arch:described_work a rdf:Property ; rdfs:comment "chord_sequence 1: the Work the sequence describes. Minted by World." .
arch:section a rdf:Property ; rdfs:comment "A sequence entry's section label as the source writes it; never a lyric." .
arch:locator_line a rdf:Property ; rdfs:comment "A sequence locator's line in the document." .
arch:locator_word a rdf:Property ; rdfs:comment "A sequence locator's word in its line." .
arch:locator_syllable a rdf:Property ; rdfs:comment "A sequence locator's syllable in its line." .
arch:locator_column a rdf:Property ; rdfs:comment "A sequence locator's column in its line." .
arch:repeats a rdf:Property ; rdfs:comment "chord_sequence 1: one repeated range node." .
arch:first_entry a rdf:Property ; rdfs:comment "A repeat's first entry." .
arch:last_entry a rdf:Property ; rdfs:comment "A repeat's last entry." .
arch:times a rdf:Property ; rdfs:comment "How many times a repeat is played." .
arch:contribution_scope a rdf:Property ; rdfs:comment "contribution 1: work, release, recording, span, or channel." .
arch:credit_text a rdf:Property ; rdfs:comment "contribution 1, band_membership 1: the credit exactly as the source printed it." .
arch:credited_as a rdf:Property ; rdfs:comment "The contributor's name as printed." .
arch:credited_spans a rdf:Property ; rdfs:comment "contribution 1, span scope: one credited span node." .
arch:channel_index a rdf:Property ; rdfs:comment "contribution 1, channel scope: the 1-based channel of a multichannel source." .
arch:part_of_recording a rdf:Property ; rdfs:comment "contribution 1, span or channel scope: the recording the audio is part of. Minted by World." .
arch:retrieved_at a rdf:Property ; rdfs:comment "When a document was retrieved, as written: a full date or a UTC instant." .
arch:document_locator a rdf:Property ; rdfs:comment "Where in a document a credit is: a page, a track's credit list." .
arch:confidence a rdf:Property ; rdfs:comment "A machine's confidence node, compared only within its own scale." .
arch:confidence_scale a rdf:Property ; rdfs:comment "What a confidence value measures." .
arch:confidence_value a rdf:Property ; rdfs:comment "A confidence value as xsd:decimal." .
arch:role_attributes a rdf:Property ; rdfs:comment "A MusicBrainz attribute of a role, such as co or guest." .
arch:instruments a rdf:Property ; rdfs:comment "A MusicBrainz instrument a role or membership names." .
arch:vocals a rdf:Property ; rdfs:comment "A vocal attribute concept of D-17's role scheme." .
arch:contributor a rdf:Property ; rdfs:comment "contribution 1: the credited person or organisation revision." .
arch:band a rdf:Property ; rdfs:comment "band_membership 1: the band, an organisation revision." .
arch:member a rdf:Property ; rdfs:comment "band_membership 1: the member, a person revision." .
arch:membership a rdf:Property ; rdfs:comment "band_membership 1: the claim's org:Membership node. Minted by World." .
arch:member_from a rdf:Property ; rdfs:comment "A membership's start as a MusicBrainz partial date." .
arch:member_to a rdf:Property ; rdfs:comment "A membership's end as a MusicBrainz partial date." .
arch:membership_ended a rdf:Property ; rdfs:comment "true: the membership ended at an unknown date." .

# Specification 0.0.10 (D-18), added in revision 6. Each term is its
# contract's context term unless it says it is minted by World; a field the
# context leaves to the core context, or a term an earlier shape targets, is
# minted, as world/contract_graphs.py lists.

arch:adopted_by a rdf:Property ; rdfs:comment "lead_sheet 1: a band membership claim of the member who adopted the lead sheet for the band." .
arch:adopting_band a rdf:Property ; rdfs:comment "lead_sheet 1: the band, an organisation revision, whose lead sheet this is." .
arch:audio_extent a rdf:Property ; rdfs:comment "recording_audio 1: whole or part: how much of the recording the archived audio holds." .
arch:bank_stem a rdf:Property ; rdfs:comment "A stem cited by bank key (ADR 0079): a node naming one bank file, which stays regenerable." .
arch:bank_extractor a rdf:Property ; rdfs:comment "A cited stem's bank extractor." .
arch:bank_key a rdf:Property ; rdfs:comment "A cited stem's bank entry key, sha256:<hex>." .
arch:bank_output a rdf:Property ; rdfs:comment "A cited stem's output name, such as bass." .
arch:bank_file_digest a rdf:Property ; rdfs:comment "A cited stem file's SHA-256, sha256:<hex>." .
arch:bar_chords a rdf:Property ; rdfs:comment "meter_layers 2, a written bar: one chord node, the sequence entry it holds and where in the bar." .
arch:bar_index a rdf:Property ; rdfs:comment "melody 1: a bar of the meter the tune is laid on, counted as its contract states." .
arch:bar_offset a rdf:Property ; rdfs:comment "Where in a bar something starts, a written length node. Minted by World, since at is a core term." .
arch:note_count a rdf:Property ; rdfs:comment "A written length's count of units." .
arch:note_unit a rdf:Property ; rdfs:comment "A written length's unit, a fraction of a whole note: 4 is a quarter." .
arch:capo_fret a rdf:Property ; rdfs:comment "The fret a capo stops every string at." .
arch:chords_of_bars a rdf:Property ; rdfs:comment "meter_layers 2: the chord sequence whose entries written bars hold." .
arch:chosen_chords a rdf:Property ; rdfs:comment "lead_sheet 1: chords the lead sheet's asserter chose to show." .
arch:chosen_credits a rdf:Property ; rdfs:comment "lead_sheet 1: a credit the lead sheet shows." .
arch:chosen_form a rdf:Property ; rdfs:comment "lead_sheet 1: the form the lead sheet shows." .
arch:chosen_key a rdf:Property ; rdfs:comment "lead_sheet 1: the key claim the lead sheet is spelled by." .
arch:chosen_lyric_timing a rdf:Property ; rdfs:comment "lead_sheet 1: the timed lyrics the lead sheet follows." .
arch:chosen_lyrics a rdf:Property ; rdfs:comment "lead_sheet 1: the lyric document the lead sheet joins when shown." .
arch:chosen_melody a rdf:Property ; rdfs:comment "lead_sheet 1: the melody the lead sheet shows." .
arch:chosen_meter a rdf:Property ; rdfs:comment "lead_sheet 1: the meter the lead sheet shows." .
arch:coda_from a rdf:Property ; rdfs:comment "form 1: the section after which a jump's return goes to the coda." .
arch:coda_section a rdf:Property ; rdfs:comment "form 1: the coda section a jump's return ends in." .
arch:consent_covers a rdf:Property ; rdfs:comment "sharing_consent 1: a revision the consent covers." .
arch:consent_decision a rdf:Property ; rdfs:comment "sharing_consent 1: approve or refuse." .
arch:consent_destination a rdf:Property ; rdfs:comment "sharing_consent 1: the destination the co-writer answers for." .
arch:consent_origin a rdf:Property ; rdfs:comment "sharing_consent 1: the work origin claim naming the consenting co-writer." .
arch:consent_reason a rdf:Property ; rdfs:comment "sharing_consent 1: why, in the co-writer's words. Minted by World, since reason names a judgment's." .
arch:described_document a rdf:Property ; rdfs:comment "document_source 1: the document Artifact the claim describes." .
arch:document_kinds a rdf:Property ; rdfs:comment "document_source 1: one kind of document the Artifact is, such as lyrics or chart." .
arch:document_line a rdf:Property ; rdfs:comment "timed_lyrics 1: a line's number in the lyric document." .
arch:drift_cents a rdf:Property ; rdfs:comment "tuning 1: a drift span's own offset from A = 440 Hz in cents, as xsd:decimal." .
arch:ending_passes a rdf:Property ; rdfs:comment "form 1: a pass of the repeat that takes this ending." .
arch:export_format a rdf:Property ; rdfs:comment "export 1: the exported file's format." .
arch:export_key a rdf:Property ; rdfs:comment "export 1: the key of the export request, sha256:<hex>." .
arch:export_losses a rdf:Property ; rdfs:comment "export 1: something the format could not hold." .
arch:export_options a rdf:Property ; rdfs:comment "export 1: the options the exporter read, as rdf:JSON, since their names are the exporter's." .
arch:export_software a rdf:Property ; rdfs:comment "export 1: one program the exporter reports, in order. Minted by World, since software is a core term." .
arch:exporter a rdf:Property ; rdfs:comment "export 1: the exporter node, its identifier and version." .
arch:external_entry a rdf:Property ; rdfs:comment "catalogue_correspondence 1: the MusicBrainz or Discogs entry." .
arch:file_name a rdf:Property ; rdfs:comment "document_source 1: the file name the document was given, never a path." .
arch:fine_section a rdf:Property ; rdfs:comment "form 1: the section a jump's return ends at (al fine)." .
arch:first_position a rdf:Property ; rdfs:comment "key_sequence 1: a region's first chord sequence entry or form section." .
arch:last_position a rdf:Property ; rdfs:comment "key_sequence 1: a region's last chord sequence entry or form section." .
arch:first_section a rdf:Property ; rdfs:comment "form 1: a repeat's or ending's first section." .
arch:last_section a rdf:Property ; rdfs:comment "form 1: a repeat's or ending's last section." .
arch:form_jumps a rdf:Property ; rdfs:comment "form 1: one jump node (da capo or dal segno)." .
arch:form_of_bars a rdf:Property ; rdfs:comment "meter_layers 2: the form whose sections written bars are in." .
arch:form_repeats a rdf:Property ; rdfs:comment "form 1: one repeated range of sections. Minted by World, since arch:repeats is a chord sequence's." .
arch:form_section a rdf:Property ; rdfs:comment "The section of a form a span or bar is in." .
arch:form_sections a rdf:Property ; rdfs:comment "form 1: one section node, in written order." .
arch:form_spans a rdf:Property ; rdfs:comment "form_spans 1: one span node of sections at samples." .
arch:instrument a rdf:Property ; rdfs:comment "lead_sheet 1: a part's MusicBrainz instrument." .
arch:joined a rdf:Property ; rdfs:comment "export 1: an Artifact the export joined, such as a lyric document." .
arch:judged_entries a rdf:Property ; rdfs:comment "judgment 2: the range of the judged sequence's entries judged." .
arch:judged_entry a rdf:Property ; rdfs:comment "judgment 2: the entry whose reading is judged." .
arch:judged_reading a rdf:Property ; rdfs:comment "judgment 2: the reading judged, a node naming a span or entry and the reading's index." .
arch:judged_span a rdf:Property ; rdfs:comment "judgment 2: the samples judged, or the span whose reading is judged." .
arch:jump_after a rdf:Property ; rdfs:comment "form 1: the section a jump is taken after." .
arch:jump_kind a rdf:Property ; rdfs:comment "form 1: da_capo or dal_segno. Minted by World, since kind is a core term." .
arch:jump_then a rdf:Property ; rdfs:comment "form 1: what the return does: end, fine, or coda." .
arch:jump_to a rdf:Property ; rdfs:comment "form 1: the section a dal segno jump returns to." .
arch:jurisdiction a rdf:Property ; rdfs:comment "rights 1: where the statement holds." .
arch:key_anchor_form a rdf:Property ; rdfs:comment "key_sequence 1: the form whose sections the regions range over." .
arch:key_anchor_sequence a rdf:Property ; rdfs:comment "key_sequence 1: the chord sequence whose entries the regions range over." .
arch:key_readings a rdf:Property ; rdfs:comment "One key reading of a region, ranked: rdf:value is its rank." .
arch:key_regions a rdf:Property ; rdfs:comment "key_sequence 1, key_regions 1: one region node." .
arch:laid_on_meter a rdf:Property ; rdfs:comment "melody 1: the untimed meter the tune is laid on." .
arch:lead_sheet_parts a rdf:Property ; rdfs:comment "lead_sheet 1: one part node." .
arch:length_ms a rdf:Property ; rdfs:comment "tracklist 1: a track's printed length in milliseconds." .
arch:licensee a rdf:Property ; rdfs:comment "rights 1: who a licence is granted to." .
arch:limit_reason a rdf:Property ; rdfs:comment "sensitivity 1: why, in the person's words. Minted by World, since reason names a judgment's." .
arch:limited_subject a rdf:Property ; rdfs:comment "sensitivity 1: an object the label limits." .
arch:line_word a rdf:Property ; rdfs:comment "timed_lyrics 1: a word's number in its line." .
arch:listed_tracks a rdf:Property ; rdfs:comment "tracklist 1: one track node of a medium. Minted by World, since arch:tracks is a selection's." .
arch:locator_scheme a rdf:Property ; rdfs:comment "timed_lyrics 1: how the document's lines and words are counted." .
arch:lyric_document a rdf:Property ; rdfs:comment "timed_lyrics 1: the lyric document whose lines are placed; its words are never copied." .
arch:mapped_artist a rdf:Property ; rdfs:comment "catalogue_correspondence 1: the artist Entity mapped." .
arch:mapping_relation a rdf:Property ; rdfs:comment "catalogue_correspondence 1: the SKOS mapping property, an IRI." .
arch:mark_about a rdf:Property ; rdfs:comment "span_annotation 1: a claim the mark is about." .
arch:mark_kind a rdf:Property ; rdfs:comment "span_annotation 1: unsure, interesting, or note. Minted by World, since kind is a core term." .
arch:mark_text a rdf:Property ; rdfs:comment "span_annotation 1: a note's text." .
arch:marked_entries a rdf:Property ; rdfs:comment "span_annotation 1: the range of the marked sequence's entries." .
arch:marked_sequence a rdf:Property ; rdfs:comment "span_annotation 1: the chord sequence marked." .
arch:marked_span a rdf:Property ; rdfs:comment "span_annotation 1: the samples marked." .
arch:measured_on_tuning a rdf:Property ; rdfs:comment "The tuning claim whose grid the pitch classes are steps of (D-17)." .
arch:media a rdf:Property ; rdfs:comment "tracklist 1: one medium node." .
arch:media_type a rdf:Property ; rdfs:comment "A document's or exported file's media type." .
arch:medium_format a rdf:Property ; rdfs:comment "tracklist 1: a medium's format as printed." .
arch:medium_position a rdf:Property ; rdfs:comment "recording_audio 1: the medium of the tracklist the audio is on." .
arch:melody_items a rdf:Property ; rdfs:comment "melody 1: one note or rest node, in order." .
arch:melody_spans a rdf:Property ; rdfs:comment "melody_spans 1: one span node selecting a notes claim." .
arch:melody_start a rdf:Property ; rdfs:comment "melody 1: where the tune starts in its meter." .
arch:meter_layer_index a rdf:Property ; rdfs:comment "melody 1: the layer of the meter the tune starts in." .
arch:midi_pitch a rdf:Property ; rdfs:comment "A note's MIDI pitch." .
arch:mode_name a rdf:Property ; rdfs:comment "A key reading's mode." .
arch:no_key a rdf:Property ; rdfs:comment "true: the asserter states that no key holds." .
arch:note_events a rdf:Property ; rdfs:comment "notes 1: one sounded note node." .
arch:note_selection a rdf:Property ; rdfs:comment "melody_spans 1: highest, lowest, or all of the notes starting together." .
arch:notes_range a rdf:Property ; rdfs:comment "notes 1: the samples the claim speaks for." .
arch:offset_sample a rdf:Property ; rdfs:comment "notes 1: a note's last sounding sample, exclusive." .
arch:onset_sample a rdf:Property ; rdfs:comment "notes 1: a note's first sounding sample." .
arch:open_strings a rdf:Property ; rdfs:comment "A part's open strings as MIDI notes in tablature order, one text separated by spaces, since order and repetition are the meaning." .
arch:part_name a rdf:Property ; rdfs:comment "lead_sheet 1: a part's name. Minted by World, since name is a core term." .
arch:partial_tracklist a rdf:Property ; rdfs:comment "tracklist 1: true when the list leaves tracks out." .
arch:pitch_cents a rdf:Property ; rdfs:comment "notes 1: a note's offset from its pitch in cents, as xsd:decimal." .
arch:pitch_collection a rdf:Property ; rdfs:comment "A key reading's pitch class." .
arch:placed_by_tracklist a rdf:Property ; rdfs:comment "recording_audio 1: the tracklist whose track the audio is." .
arch:placed_form a rdf:Property ; rdfs:comment "form_spans 1: the form whose sections the spans place." .
arch:placed_from a rdf:Property ; rdfs:comment "meter_layers 2: the written bar of the pinned untimed meter a placed bar came from." .
arch:placed_key_sequence a rdf:Property ; rdfs:comment "key_regions 1: the key sequence whose regions were placed." .
arch:placed_meter a rdf:Property ; rdfs:comment "meter_layers 2: the untimed meter a timed claim placed." .
arch:position a rdf:Property ; rdfs:comment "tracklist 1: a medium's or track's position, from 1." .
arch:printed_artist a rdf:Property ; rdfs:comment "tracklist 1: a track's artist as printed." .
arch:printed_title a rdf:Property ; rdfs:comment "tracklist 1: a medium's or track's title as printed." .
arch:recording_audio a rdf:Property ; rdfs:comment "recording_audio 1: the archived audio that is the recording." .
arch:reference_cents a rdf:Property ; rdfs:comment "tuning 1: where the twelve-tone grid lies, in cents from A = 440 Hz, as xsd:decimal." .
arch:rendered a rdf:Property ; rdfs:comment "export 1: a claim the export rendered, in order." .
arch:repeat_endings a rdf:Property ; rdfs:comment "form 1: one ending node of a repeat." .
arch:repeats_on_return a rdf:Property ; rdfs:comment "form 1: true when repeats are played again after a jump." .
arch:rest a rdf:Property ; rdfs:comment "melody 1: true for a rest." .
arch:retrieved_from a rdf:Property ; rdfs:comment "document_source 1: the URL the bytes came from." .
arch:rights_from a rdf:Property ; rdfs:comment "rights 1: when the statement starts to hold, a partial date." .
arch:rights_until a rdf:Property ; rdfs:comment "rights 1: when the statement stops holding, a partial date." .
arch:rights_holder a rdf:Property ; rdfs:comment "rights 1: who holds the rights." .
arch:rights_statement a rdf:Property ; rdfs:comment "rights 1: the statement's concept of D-18's rights scheme, arch:rights-{statement}." .
arch:rights_subject a rdf:Property ; rdfs:comment "rights 1: an Artifact, Work, recording, or release the statement is about." .
arch:rights_text a rdf:Property ; rdfs:comment "rights 1: the terms as written." .
arch:section_kind a rdf:Property ; rdfs:comment "form 1, form_spans 1: a section's kind, such as verse. Minted by World, since kind is a core term." .
arch:sequence_region a rdf:Property ; rdfs:comment "key_regions 1: the region of the placed key sequence a region was placed from." .
arch:spelling a rdf:Property ; rdfs:comment "A key reading's own names of its classes, in the collection's order, one text separated by spaces." .
arch:timed_lines a rdf:Property ; rdfs:comment "timed_lyrics 1: one line node." .
arch:timed_words a rdf:Property ; rdfs:comment "timed_lyrics 1: one word node of a line." .
arch:tlp_label a rdf:Property ; rdfs:comment "sensitivity 1: the TLP 2.0 label. Minted by World, since label is a core term." .
arch:tonic a rdf:Property ; rdfs:comment "A key reading's tonic pitch class." .
arch:track_number_text a rdf:Property ; rdfs:comment "tracklist 1: a track's number as printed." .
arch:track_position a rdf:Property ; rdfs:comment "recording_audio 1: the track of the medium the audio is." .
arch:track_recording a rdf:Property ; rdfs:comment "tracklist 1: a recording Entity the list places, one per track in order." .
arch:tune_notes a rdf:Property ; rdfs:comment "melody_spans 1: a notes claim the tune is selected from." .
arch:tuning_drift a rdf:Property ; rdfs:comment "tuning 1: one drift span node." .
arch:unpitched a rdf:Property ; rdfs:comment "notes 1: true for an unpitched part." .
arch:velocity a rdf:Property ; rdfs:comment "notes 1: a note's MIDI velocity." .
arch:work_origin a rdf:Property ; rdfs:comment "work_origin 1: own, co_written, or others." .
arch:writer a rdf:Property ; rdfs:comment "work_origin 1: a person who wrote the Work." .
arch:written_duration a rdf:Property ; rdfs:comment "A written length node." .
arch:written_in_band a rdf:Property ; rdfs:comment "work_origin 1: the band the Work was written in." .

# Revision 7: specification 0.0.10's amendments (ADRs 0085, 0086, 2026-10-19).
arch:articulation a rdf:Property ; rdfs:comment "notes 1, melody 1: one written articulation of a note, such as staccato; a document's or a person's, never a machine's (revision 7)." .
arch:bass_line a rdf:Property ; rdfs:comment "notes 1: true when the part is the bass line, a line of its own (revision 7)." .
arch:carried_by a rdf:Property ; rdfs:comment "timed_lyrics 1: the notes that carry a syllable (revision 7)." .
arch:carrying_notes a rdf:Property ; rdfs:comment "timed_lyrics 1: a notes claim revision whose notes carry syllables (revision 7)." .
arch:carrying_onsets a rdf:Property ; rdfs:comment "timed_lyrics 1: the onset sample of one note that carries a syllable; several are a melisma (revision 7)." .
arch:destination a rdf:Property ; rdfs:comment "publication_approval 2: the destination, recorded exactly (revision 7)." .
arch:end_char a rdf:Property ; rdfs:comment "timed_lyrics 1: where a syllable ends in its word, in code points from 0, exclusive (revision 7)." .
arch:exposure_class a rdf:Property ; rdfs:comment "publication_approval 2: the exposure class of the destination, the furthest the approval reaches (revision 7)." .
arch:publication_decision a rdf:Property ; rdfs:comment "publication_approval 2: approve, or hold_back (revision 7)." .
arch:start_char a rdf:Property ; rdfs:comment "timed_lyrics 1: where a syllable starts in its word, in code points from 0 (revision 7)." .
arch:timed_syllables a rdf:Property ; rdfs:comment "timed_lyrics 1: one syllable node of a word (revision 7)." .
arch:withdrawal_reason a rdf:Property ; rdfs:comment "publication_withdrawal 2: why the approval is withdrawn. Minted by World, since arch:reason names a judgment's (revision 7)." .
arch:word_syllable a rdf:Property ; rdfs:comment "timed_lyrics 1: a syllable's number in its word (revision 7)." .

# Revision 8: specification 0.0.11 (ADR 0113).
arch:alignment_precision a rdf:Property ; rdfs:comment "form_spans 2: what is known about the span boundaries, rough, approximate, or exact, whoever placed them (revision 8)." .
arch:carrying_items a rdf:Property ; rdfs:comment "underlay 1: one melody item a word or syllable is sung on, the item's node in the pinned melody; several are a melisma (revision 8)." .
arch:carrying_melody a rdf:Property ; rdfs:comment "underlay 1: the Work-level melody revision whose items carry the words (revision 8)." .
arch:chosen_underlay a rdf:Property ; rdfs:comment "lead_sheet 2: an underlay the lead sheet shows, the words under its melody (revision 8)." .
arch:pass_form a rdf:Property ; rdfs:comment "underlay 1: the form revision whose repeat the named passes are of (revision 8)." .
arch:played_on_return a rdf:Property ; rdfs:comment "form_spans 2: true when the span is played on a D.C. or D.S. return (revision 8)." .
arch:played_passes a rdf:Property ; rdfs:comment "form_spans 2: the pass of one repeat around the span's section, outer first (revision 8)." .
arch:repeat_index a rdf:Property ; rdfs:comment "underlay 1: the repeat of the pinned form whose passes the words go under, the repeat's node (revision 8)." .
arch:repeat_instruction a rdf:Property ; rdfs:comment "form 2: the source's own words for how a repeat is played, verbatim; nothing parses them (revision 8)." .
arch:sung_pass_numbers a rdf:Property ; rdfs:comment "underlay 1: one pass of the named repeat the words are sung under, a number or last. Minted by World, since arch:sung_passes names the node that holds them (revision 8)." .
arch:sung_passes a rdf:Property ; rdfs:comment "underlay 1: the repeat and passes the words are sung under (revision 8)." .
arch:underlay_lines a rdf:Property ; rdfs:comment "underlay 1: one placed line of the lyric document (revision 8)." .
arch:underlay_syllables a rdf:Property ; rdfs:comment "underlay 1: one syllable of a placed word, by its characters in the word (revision 8)." .
arch:underlay_words a rdf:Property ; rdfs:comment "underlay 1: one placed word of a line (revision 8)." .
arch:bar_directions a rdf:Property ; rdfs:comment "meter_layers 3, a written bar: one direction written over it, its text and optional target tempo, an intention and never a reading of audio (ADR 0116, revision 8)." .
arch:direction_text a rdf:Property ; rdfs:comment "meter_layers 3: a direction's text, verbatim, such as a style or Solos; never a lyric line (revision 8)." .
arch:direction_tempo a rdf:Property ; rdfs:comment "meter_layers 3: a direction's target tempo node, ADR 0106's shape; tempo stays derived for every timed claim (revision 8)." .
arch:target_bpm a rdf:Property ; rdfs:comment "A target tempo's beats a minute, xsd:decimal: an intention (ADR 0106), on a direction since meter_layers 3 (revision 8)." .
arch:target_beat a rdf:Property ; rdfs:comment "A target tempo's beat, the note value counted; absent, whatever beat the band counts (ADR 0106, revision 8)." .

# Capture clocks (ADR 0107, specification 0.0.12)
arch:capture_subject a rdf:Property ; rdfs:comment "capture_start 1: the Artifact revision whose capture began." .
arch:capture_started a rdf:Property ; rdfs:comment "capture_start 1: device wall time, typed dateTime only for a stated offset." .
arch:capture_clock a rdf:Property ; rdfs:comment "capture_start 1: local or zoned, present exactly with a stated start." .
arch:capture_basis a rdf:Property ; rdfs:comment "capture_start 1: grammar, header, client or person." .
