  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:TuningDrift a sh:NodeShape ;
  rdfs:comment "tuning 1: one span of samples whose own offset holds there." ;
  sh:targetObjectsOf arch:tuning_drift ;
  sh:closed true ;
