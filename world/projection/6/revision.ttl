# World projection 6: one graph per claim or assessment revision,
# <{archive}#revision={revision_id}>. It holds the relations that exact
# revision asserts, so competing claims stay separate and attributable.
# Every shape is closed (ADR 0059).

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix arch: <urn:uuid:3e8b29f8-70c9-403e-bb4c-2280d59eca7f#> .
@prefix wsh: <urn:uuid:3e8b29f8-70c9-403e-bb4c-2280d59eca7f#world-projection-6/shapes/> .

wsh:Asserted a sh:NodeShape ;
  rdfs:comment "A revision, or an object (performance_work version 1), as the subject of what the graph's claim asserts." ;
  sh:targetSubjectsOf arch:piece, arch:tracks, arch:alignment, arch:reference, arch:alignment_aligned,
    arch:reference_rate, arch:aligned_rate, arch:max_error_samples, arch:anchors, arch:selection, arch:work,
    arch:performance_kind, dcterms:title, arch:credit, arch:session_part, arch:assessment_of, arch:verdict,
    arch:reason, arch:score ;
  sh:closed true ;
  sh:property [ sh:path arch:piece ; sh:nodeKind sh:IRI ; rdfs:comment "audio_selection version 1: each span." ] ;
  sh:property [ sh:path arch:tracks ; sh:nodeKind sh:IRI ; rdfs:comment "audio_selection version 2: each track." ] ;
  sh:property [ sh:path arch:alignment ; sh:nodeKind sh:IRI ; rdfs:comment "audio_selection version 2: a capture_alignment revision relied on." ] ;
  sh:property [ sh:path arch:reference ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:alignment_aligned ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:reference_rate ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:aligned_rate ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:max_error_samples ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:alignment_method ; sh:maxCount 1 ; sh:datatype xsd:string ;
                rdfs:comment "A document alignment that states its bound is also a subject of arch:max_error_samples, so this shape admits its method too (revision 5)." ] ;
  sh:property [ sh:path arch:anchors ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:selection ; sh:nodeKind sh:IRI ; rdfs:comment "song_occurrence: each selection revision; work_match 2: the compared selection." ] ;
  sh:property [ sh:path arch:work ; sh:nodeKind sh:IRI ; rdfs:comment "performance_work: the Work linked to the performance; work_match 2 and 3: the matched Work revision." ] ;
  sh:property [ sh:path arch:performance ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "work_match 2: the compared song occurrence revision." ] ;
  sh:property [ sh:path arch:match_corpus ; sh:nodeKind sh:IRI ; rdfs:comment "work_match 2 and 3: each occurrence revision in the compared corpus." ] ;
  sh:property [ sh:path arch:score ; sh:maxCount 1 ; sh:datatype xsd:decimal ; rdfs:comment "work_match 2 and 3: the score, compared within its scale only." ] ;
  sh:property [ sh:path arch:score_scale ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:score_direction ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "higher_is_closer" "lower_is_closer" ) ] ;
  sh:property [ sh:path arch:method ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "work_match 2 and 3: the method the payload names." ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "work_match 2 and 3: the derivation run that made the match." ] ;
  sh:property [ sh:path arch:parameters ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "work_match 2 and 3: the Artifact revision holding the method's parameters." ] ;
  sh:property [ sh:path arch:compared_suggestions ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "work_match 3: the span_suggestions revision the window is cut from (revision 4)." ] ;
  sh:property [ sh:path arch:window ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "work_match 3: the compared window, <{revision}:window> (revision 4)." ] ;
  sh:property [ sh:path arch:performance_kind ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "selection_kind: a concept in the performance-kinds scheme of the domain graph." ] ;
  sh:property [ sh:path dcterms:title ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:credit ; sh:nodeKind sh:IRI ; rdfs:comment "artist_credit: each credit, in order." ] ;
  sh:property [ sh:path arch:session_part ; sh:nodeKind sh:IRI ; rdfs:comment "session_parts: each part, in order." ] ;
  sh:property [ sh:path arch:assessment_of ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:verdict ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "affirmed" "rejected" "withdrawn" ) ] ;
  sh:property [ sh:path arch:reason ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:sample_rate ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "judgment 2: the rate of a judged span's samples (revision 6)." ] ;
  sh:property [ sh:path arch:judged_span ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "judgment 2: the samples judged (revision 6)." ] ;
  sh:property [ sh:path arch:judged_entries ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "judgment 2: the entries judged (revision 6)." ] ;
  sh:property [ sh:path arch:judged_reading ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "judgment 2: the reading judged (revision 6)." ] .

wsh:Correspondence a sh:NodeShape ;
  rdfs:comment "work_musicbrainz_correspondence: a local Work concept mapped to a MusicBrainz Work concept." ;
  sh:targetSubjectsOf skos:exactMatch, skos:closeMatch ;
  sh:closed true ;
  sh:property [ sh:path skos:exactMatch ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path skos:closeMatch ; sh:nodeKind sh:IRI ] .

wsh:Span a sh:NodeShape ;
  rdfs:comment "One span of samples of one Artifact revision; rdf:value is its position from 0." ;
  sh:targetObjectsOf arch:piece, arch:pieces ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:end_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:sample_rate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Track a sh:NodeShape ;
  rdfs:comment "One source's ordered spans; rdf:value is the track's position from 0." ;
  sh:targetObjectsOf arch:tracks ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:pieces ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Anchor a sh:NodeShape ;
  rdfs:comment "A reference sample and the aligned sample recorded at the same instant; rdf:value is its position from 0." ;
  sh:targetObjectsOf arch:anchors ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:reference_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:aligned_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:Credit a sh:NodeShape ;
  rdfs:comment "One credited person or organisation revision; rdf:value is the credit order from 0." ;
  sh:targetObjectsOf arch:credit ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:credited_artist ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Part a sh:NodeShape ;
  rdfs:comment "One part of a recording session, an Artifact revision; rdf:value is its recording order from 0." ;
  sh:targetObjectsOf arch:session_part ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# Specification 0.0.7: derivation runs and what they make (ADRs 0064 to
# 0067), added in revision 3.

wsh:Run a sh:NodeShape ;
  rdfs:comment "derivation_run 1: the run's own revision, typed prov:Activity in its graph. Outputs name it with prov:wasGeneratedBy." ;
  sh:targetClass prov:Activity ;
  sh:closed true ;
  sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( prov:Activity ) ] ;
  sh:property [ sh:path arch:method ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path prov:startedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  sh:property [ sh:path prov:endedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  sh:property [ sh:path prov:wasAssociatedWith ; sh:nodeKind sh:IRI ; rdfs:comment "Each program the output depends on." ] ;
  sh:property [ sh:path prov:used ; sh:nodeKind sh:IRI ; rdfs:comment "Each Artifact, Claim, or Entity revision the run read." ] ;
  sh:property [ sh:path arch:parameters ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "The Artifact revision holding the run's configuration as canonical JSON." ] .

wsh:Method a sh:NodeShape ;
  rdfs:comment "The method a run executed or a match names, <{revision}:method>." ;
  sh:targetObjectsOf arch:method ;
  sh:closed true ;
  sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:version ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:Software a sh:NodeShape ;
  rdfs:comment "One program or library a run reports, <{revision}:software={n}>; rdf:value is its reported position from 0." ;
  sh:targetClass prov:SoftwareAgent ;
  sh:closed true ;
  sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( prov:SoftwareAgent ) ] ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path foaf:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:version ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:Streamed a sh:NodeShape ;
  rdfs:comment "audio_stream 1: the Artifact revision the claim describes, as the subject of its stream." ;
  sh:targetSubjectsOf arch:audio_stream ;
  sh:closed true ;
  sh:property [ sh:path arch:audio_stream ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Stream a sh:NodeShape ;
  rdfs:comment "audio_stream 1: one stream's facts, <{revision}:stream>. Its duration in seconds is sample_count / sample_rate." ;
  sh:targetObjectsOf arch:audio_stream ;
  sh:closed true ;
  sh:property [ sh:path arch:stream_index ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:codec ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:sample_rate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:channel_count ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:sample_count ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:bits_per_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Suggestions a sh:NodeShape ;
  rdfs:comment "span_suggestions 1: one run's suggested spans for one source Artifact revision." ;
  sh:targetSubjectsOf arch:suggested_spans ;
  sh:closed true ;
  sh:property [ sh:path arch:suggested_spans ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "The source Artifact revision." ] ;
  sh:property [ sh:path arch:measured_stream ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:sample_rate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:Window a sh:NodeShape ;
  rdfs:comment "work_match 3: the compared window, a run of whole suggested spans of the claim's compared_suggestions, at their sample rate. A window is a suggestion, never a selection (revision 4)." ;
  sh:targetObjectsOf arch:window ;
  sh:closed true ;
  sh:property [ sh:path arch:start_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:end_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:sample_rate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:SuggestedSpan a sh:NodeShape ;
  rdfs:comment "One suggested span, <{revision}:span={n}>; rdf:value is its position from 0. A suggestion is never a selection." ;
  sh:targetObjectsOf arch:suggested_spans ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:end_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:span_class ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:in ( "music" "talk" "quiet" "unknown" ) ] .

# Specification 0.0.9: chord stacks and meter layers (ADR 0077), and
# contributions and band membership (ADR 0078), added in revision 5. Names of
# chords are computed views and are not projected.

wsh:ChordStacks a sh:NodeShape ;
  rdfs:comment "chord_stacks 1: one asserter's readings of what sounds over spans of one source's samples." ;
  sh:targetSubjectsOf arch:chord_spans ;
  sh:closed true ;
  sh:property [ sh:path arch:chord_spans ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:part ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:weight_scale ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:part_contribution ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "The contribution saying whose part the stacks describe." ] ;
  sh:property [ sh:path arch:placed_sequence ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "The chord_sequence revision an alignment placed on this recording." ] ;
  sh:property [ sh:path arch:corrects ; sh:maxCount 8 ; sh:nodeKind sh:IRI ;
                rdfs:comment "A chord stacks revision this claim corrects; it stays, untouched." ] ;
  sh:property [ sh:path arch:hold_rule ; sh:maxCount 1 ; sh:datatype xsd:string ;
                rdfs:comment "How the asserter held the spans whose end is held." ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "The source Artifact revision: the mix whose samples are counted; for version 2, also each claim it was derived_from (revision 6)." ] ;
  sh:property [ sh:path arch:bank_stem ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "chord_stacks 2: the stem read, cited by bank key (revision 6)." ] ;
  sh:property [ sh:path arch:measured_stream ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:sample_rate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:analysed_audio ; sh:maxCount 8 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path dcterms:source ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:document_url ; sh:maxCount 1 ; sh:datatype xsd:anyURI ] ;
  sh:property [ sh:path arch:document_alignment ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:MeterLayers a sh:NodeShape ;
  rdfs:comment "meter_layers 1 and 2: one asserter's simultaneous layers of bars, over one source's samples, or (version 2, untimed) about a Work or a document in written bars. Tempo is derived, never stored." ;
  sh:targetSubjectsOf arch:meter_layers ;
  sh:closed true ;
  sh:property [ sh:path arch:meter_layers ; sh:minCount 1 ; sh:maxCount 8 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:metric_modulations ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:nodeKind sh:IRI ;
                rdfs:comment "A timed claim's source Artifact revision, the mix whose samples are counted, and each claim a version 2 claim was derived_from." ] ;
  sh:property [ sh:path arch:measured_stream ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "Every timed claim has one." ] ;
  sh:property [ sh:path arch:sample_rate ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "Every timed claim has one." ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:analysed_audio ; sh:maxCount 8 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path dcterms:source ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:document_url ; sh:maxCount 1 ; sh:datatype xsd:anyURI ] ;
  sh:property [ sh:path arch:document_alignment ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:bank_stem ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "version 2: the stem read, cited by bank key (revision 6)." ] ;
  sh:property [ sh:path arch:corrects ; sh:nodeKind sh:IRI ; rdfs:comment "version 2: a meter claim this one corrects (revision 6)." ] ;
  sh:property [ sh:path arch:described_work ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "version 2, untimed: the Work (revision 6)." ] ;
  sh:property [ sh:path arch:form_of_bars ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "version 2, untimed: the form whose sections the bars are in (revision 6)." ] ;
  sh:property [ sh:path arch:chords_of_bars ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "version 2, untimed: the chord sequence whose entries the bars hold (revision 6)." ] ;
  sh:property [ sh:path arch:placed_meter ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "version 2, timed: the untimed meter placed (revision 6)." ] .

wsh:DocumentAlignment a sh:NodeShape ;
  rdfs:comment "How an outside document's positions were placed on the recording's samples, <{revision}:alignment>." ;
  sh:targetObjectsOf arch:document_alignment ;
  sh:closed true ;
  sh:property [ sh:path arch:alignment_method ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:max_error_samples ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:ChordSpan a sh:NodeShape ;
  rdfs:comment "One span of chord readings, <{revision}:span={n}>; rdf:value is its position from 0." ;
  sh:targetObjectsOf arch:chord_spans ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:end_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:readings ; sh:minCount 1 ; sh:maxCount 16 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:span_end ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:in ( "asserted" "held" ) ;
                rdfs:comment "held: the source gave only a start, and the asserter held the chord by its hold_rule; weaker evidence of where the chord stops." ] ;
  sh:property [ sh:path arch:sequence_entry ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "The entry of the placed sequence this span was placed from, <{sequence revision}:entry={n}>." ] ;
  sh:property [ sh:path arch:locator ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Locator a sh:NodeShape ;
  rdfs:comment "A position in the document's own numbering: a bar, and for a chord its beat; or, in a chord sequence, a line and at most one of its word, syllable, or column." ;
  sh:targetObjectsOf arch:locator ;
  sh:closed true ;
  sh:property [ sh:path arch:locator_bar ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:locator_beat ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:locator_line ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:locator_word ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:locator_syllable ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:locator_column ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:bar_index ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "melody 1: an item's bar (revision 6)." ] ;
  sh:property [ sh:path arch:bar_offset ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "notes 1: where in the written bar a note starts (revision 6)." ] ;
  sh:property [ sh:path arch:written_duration ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "notes 1: a note's written length (revision 6)." ] .

wsh:ChordSequence a sh:NodeShape ;
  rdfs:comment "chord_sequence 1: chords in a source's written order with no times, about a Work, a document, or both. Lyrics stay in the document." ;
  sh:targetSubjectsOf arch:sequence_entries ;
  sh:closed true ;
  sh:property [ sh:path arch:sequence_entries ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:described_work ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path dcterms:source ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:corrects ; sh:maxCount 8 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:part ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:weight_scale ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:document_url ; sh:maxCount 1 ; sh:datatype xsd:anyURI ] ;
  sh:property [ sh:path arch:repeats ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:nodeKind sh:IRI ; rdfs:comment "chord_sequence 2: a claim it was derived_from (revision 6)." ] .

wsh:SequenceEntry a sh:NodeShape ;
  rdfs:comment "One entry of a chord sequence, <{revision}:entry={n}>; rdf:value is its written position from 0." ;
  sh:targetObjectsOf arch:sequence_entries ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:section ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:locator ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:readings ; sh:minCount 1 ; sh:maxCount 16 ; sh:nodeKind sh:IRI ] .

wsh:Repeat a sh:NodeShape ;
  rdfs:comment "A range of a chord sequence's entries the source marks as repeated; the played order is a view." ;
  sh:targetObjectsOf arch:repeats ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:first_entry ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:last_entry ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:times ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:Reading a sh:NodeShape ;
  rdfs:comment "One reading of a span; rdf:value is its rank in the asserter's order of preference from 0. A stack has a bass; no chord has arch:no_chord; a text-only reading has only its text. Tones and voicing notes ascend, so their values in order are the arrays." ;
  sh:targetObjectsOf arch:readings ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:bass ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:tones ; sh:maxCount 12 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:root ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:uncertain_tones ; sh:maxCount 4 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:voicing ; sh:maxCount 32 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:no_chord ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path arch:source_text ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:weight ; sh:maxCount 1 ; sh:datatype xsd:decimal ] .

wsh:UncertainTones a sh:NodeShape ;
  rdfs:comment "One group of uncertain pitch classes of a stack; rdf:value is its position from 0." ;
  sh:targetObjectsOf arch:uncertain_tones ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:pitch_classes ; sh:minCount 1 ; sh:maxCount 12 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:present ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:in ( "exactly_one" "maybe" ) ] .

wsh:MeterLayer a sh:NodeShape ;
  rdfs:comment "One layer, <{revision}:layer={n}>; rdf:value is its position from 0. No layer is primary. A layer has bars, or is beat-only: beat samples, optional downbeats among them, and an optional beat unit." ;
  sh:targetObjectsOf arch:meter_layers, arch:modulated_layer ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path rdfs:label ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:layer_role ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "written" "felt" ) ] ;
  sh:property [ sh:path arch:bars ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:beat_samples ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:downbeat_samples ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:beat_unit ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Bar a sh:NodeShape ;
  rdfs:comment "One bar, <{revision}:layer={n}:bar={m}>; rdf:value is its position from 0. A grouping is its usual notation (2+2+3); beat samples ascend." ;
  sh:targetObjectsOf arch:bars, arch:modulated_bar ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "Every bar of a timed claim has one; a written bar of version 2 has none." ] ;
  sh:property [ sh:path arch:end_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:form_section ; sh:maxCount 1 ; rdfs:comment "version 2: the section of the pinned form the bar is in (revision 6)." ] ;
  sh:property [ sh:path arch:bar_chords ; sh:nodeKind sh:IRI ; rdfs:comment "version 2: a chord the written bar holds (revision 6)." ] ;
  sh:property [ sh:path arch:placed_from ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; rdfs:comment "version 2: the written bar a placed bar came from (revision 6)." ] ;
  sh:property [ sh:path arch:numerator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:denominator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                sh:in ( 1 2 4 8 16 32 64 ) ] ;
  sh:property [ sh:path arch:grouping ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[1-9][0-9]*([+][1-9][0-9]*)*$" ] ;
  sh:property [ sh:path arch:beat_samples ; sh:maxCount 64 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:locator ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:MetricModulation a sh:NodeShape ;
  rdfs:comment "One link between adjacent bars, <{revision}:modulation={n}>: an equation (a note value before lasts as long as one after; the tempo changes by their ratio, which is derived) or a regrouping (note values keep their lengths and the felt pulse moves)." ;
  sh:targetObjectsOf arch:metric_modulations ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:modulation_kind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:in ( "equation" "regrouping" ) ] ;
  sh:property [ sh:path arch:modulated_layer ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:modulated_bar ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:before_note ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:after_note ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:pulse_before ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:pulse_after ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:NoteValue a sh:NodeShape ;
  rdfs:comment "A note value: its denominator and dots." ;
  sh:targetObjectsOf arch:before_note, arch:after_note, arch:pulse_before, arch:pulse_after, arch:beat_unit ;
  sh:closed true ;
  sh:property [ sh:path arch:denominator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:dots ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:CreditClaim a sh:NodeShape ;
  rdfs:comment "contribution 1 and band_membership 1: what the credit's asserter states about it, on the claim revision." ;
  sh:targetSubjectsOf arch:contribution_scope, arch:membership ;
  sh:closed true ;
  sh:property [ sh:path arch:contribution_scope ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:in ( "work" "release" "recording" "span" "channel" ) ] ;
  sh:property [ sh:path arch:membership ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:credit_text ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:credited_as ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:measured_stream ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:part_of_recording ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "contribution 1, span or channel scope: the recording the audio is part of." ] ;
  sh:property [ sh:path arch:sample_rate ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:credited_spans ; sh:maxCount 1000 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:channel_index ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path dcterms:source ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:document_url ; sh:maxCount 1 ; sh:datatype xsd:anyURI ] ;
  sh:property [ sh:path arch:retrieved_at ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:document_locator ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:document_alignment ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:confidence ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Attributed a sh:NodeShape ;
  rdfs:comment "contribution 1: the credited subject (a Work, release, or recording revision, or the source Artifact of a span or channel), qualified by the claim's attribution." ;
  sh:targetSubjectsOf prov:qualifiedAttribution ;
  sh:closed true ;
  sh:property [ sh:path prov:qualifiedAttribution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Attribution ] .

wsh:Attribution a sh:NodeShape ;
  rdfs:comment "contribution 1: a PROV qualified attribution, <{revision}:attribution>: the contributor and the MusicBrainz role, with its attributes, instruments, and vocals. A detector's or a place's credit has no prov:agent." ;
  sh:targetClass prov:Attribution ;
  sh:closed true ;
  sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( prov:Attribution ) ] ;
  sh:property [ sh:path prov:agent ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path prov:hadRole ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                rdfs:comment "A role type of D-17's role scheme, a concept in the domain graph." ] ;
  sh:property [ sh:path arch:role_attributes ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:instruments ; sh:maxCount 16 ; sh:nodeKind sh:IRI ;
                sh:pattern "^https://musicbrainz[.]org/instrument/" ] ;
  sh:property [ sh:path arch:vocals ; sh:nodeKind sh:IRI ;
                rdfs:comment "A vocal attribute of D-17's role scheme." ] .

wsh:Membership a sh:NodeShape ;
  rdfs:comment "band_membership 1: a W3C Organization Ontology membership, <{revision}:membership>, in MusicBrainz's member of band role, with MusicBrainz partial dates as written." ;
  sh:targetClass org:Membership ;
  sh:closed true ;
  sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( org:Membership ) ] ;
  sh:property [ sh:path org:member ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path org:organization ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path org:role ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:member_from ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:member_to ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:membership_ended ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path arch:role_attributes ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:instruments ; sh:maxCount 16 ; sh:nodeKind sh:IRI ;
                sh:pattern "^https://musicbrainz[.]org/instrument/" ] ;
  sh:property [ sh:path arch:vocals ; sh:nodeKind sh:IRI ;
                rdfs:comment "A vocal attribute of D-17's role scheme." ] .

wsh:Member a sh:NodeShape ;
  rdfs:comment "band_membership 1: the member's revision, a member of the band's revision." ;
  sh:targetSubjectsOf org:memberOf ;
  sh:closed true ;
  sh:property [ sh:path org:memberOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

wsh:Confidence a sh:NodeShape ;
  rdfs:comment "A machine's confidence in a credit, compared only within its own scale." ;
  sh:targetObjectsOf arch:confidence ;
  sh:closed true ;
  sh:property [ sh:path arch:confidence_scale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:confidence_value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] .

wsh:CreditedSpan a sh:NodeShape ;
  rdfs:comment "contribution 1, span scope: one credited span of the source's samples; rdf:value is its position from 0." ;
  sh:targetObjectsOf arch:credited_spans ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:end_sample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

# Specification 0.0.10: the contracts D-18 adds, added in revision 6 and
# projected by world/contract_graphs.py after their modules re-check them.
# A claim revision of a contract new in 0.0.10 is typed arch:Claim in its own
# graph, and this one shape lists every field any of them may state, with the
# contracts that state it. Versions 2 of chord stacks, chord sequence, meter
# layers, and judgment keep their versions 1's shapes, which admit what they
# add. An index that names a node of a pinned claim is that node's IRI when
# the claim is pinned, and a number otherwise, so those paths state no type.

wsh:Claim0010 a sh:NodeShape ;
  rdfs:comment "A claim revision of a contract specification 0.0.10 adds, as the subject of what its graph asserts." ;
  sh:targetClass arch:Claim ;
  sh:closed true ;
  sh:property [ sh:path rdf:type ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( arch:Claim ) ] ;
  sh:property [ sh:path dcterms:source ; sh:nodeKind sh:IRI ; rdfs:comment "catalogue_correspondence 1, form 1, form_spans 1, key_regions 1, key_sequence 1, lead_sheet 1, melody 1, notes 1, recording_audio 1, rights 1, tracklist 1, tuning 1." ] ;
  sh:property [ sh:path rdfs:label ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:nodeKind sh:IRI ; rdfs:comment "document_source 1, form_spans 1, key_regions 1, key_sequence 1, lead_sheet 1, melody 1, melody_spans 1, notes 1, span_annotation 1, timed_lyrics 1, tuning 1." ] ;
  sh:property [ sh:path prov:wasGeneratedBy ; sh:nodeKind sh:IRI ; rdfs:comment "catalogue_correspondence 1, document_source 1, form 1, form_spans 1, key_regions 1, key_sequence 1, melody 1, melody_spans 1, notes 1, recording_audio 1, rights 1, timed_lyrics 1, tracklist 1, tuning 1." ] ;
  sh:property [ sh:path arch:adopted_by ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:adopting_band ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:analysed_audio ; sh:nodeKind sh:IRI ; rdfs:comment "form_spans 1, notes 1." ] ;
  sh:property [ sh:path arch:audio_extent ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "recording_audio 1." ] ;
  sh:property [ sh:path arch:bank_stem ; sh:nodeKind sh:IRI ; rdfs:comment "key_regions 1, notes 1, tuning 1." ] ;
  sh:property [ sh:path arch:capo_fret ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "notes 1." ] ;
  sh:property [ sh:path arch:chosen_chords ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:chosen_credits ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:chosen_form ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:chosen_key ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:chosen_lyric_timing ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:chosen_lyrics ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:chosen_melody ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:chosen_meter ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:confidence ; sh:nodeKind sh:IRI ; rdfs:comment "catalogue_correspondence 1, recording_audio 1, tracklist 1." ] ;
  sh:property [ sh:path arch:confidence_scale ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "notes 1, timed_lyrics 1, tuning 1." ] ;
  sh:property [ sh:path arch:confidence_value ; sh:maxCount 1 ; sh:datatype xsd:decimal ; rdfs:comment "tuning 1." ] ;
  sh:property [ sh:path arch:consent_covers ; sh:nodeKind sh:IRI ; rdfs:comment "sharing_consent 1." ] ;
  sh:property [ sh:path arch:consent_decision ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "sharing_consent 1." ] ;
  sh:property [ sh:path arch:consent_destination ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "sharing_consent 1." ] ;
  sh:property [ sh:path arch:consent_origin ; sh:nodeKind sh:IRI ; rdfs:comment "sharing_consent 1." ] ;
  sh:property [ sh:path arch:consent_reason ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "sharing_consent 1." ] ;
  sh:property [ sh:path arch:corrects ; sh:nodeKind sh:IRI ; rdfs:comment "form 1, form_spans 1, key_regions 1, key_sequence 1, melody 1, melody_spans 1, notes 1, timed_lyrics 1, tuning 1." ] ;
  sh:property [ sh:path arch:credit_text ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "catalogue_correspondence 1, recording_audio 1, tracklist 1." ] ;
  sh:property [ sh:path arch:described_document ; sh:nodeKind sh:IRI ; rdfs:comment "document_source 1." ] ;
  sh:property [ sh:path arch:described_work ; sh:nodeKind sh:IRI ; rdfs:comment "document_source 1, form 1, key_sequence 1, lead_sheet 1, melody 1, span_annotation 1, timed_lyrics 1, work_origin 1." ] ;
  sh:property [ sh:path arch:document_alignment ; sh:nodeKind sh:IRI ; rdfs:comment "form_spans 1, key_regions 1, notes 1, timed_lyrics 1." ] ;
  sh:property [ sh:path arch:document_kinds ; sh:datatype xsd:string ; rdfs:comment "document_source 1." ] ;
  sh:property [ sh:path arch:document_locator ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "catalogue_correspondence 1, recording_audio 1, tracklist 1." ] ;
  sh:property [ sh:path arch:document_url ; sh:maxCount 1 ; sh:datatype xsd:anyURI ; rdfs:comment "catalogue_correspondence 1, form 1, form_spans 1, key_regions 1, key_sequence 1, melody 1, notes 1, recording_audio 1, rights 1, tracklist 1, tuning 1." ] ;
  sh:property [ sh:path arch:export_format ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "export 1." ] ;
  sh:property [ sh:path arch:export_key ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "export 1." ] ;
  sh:property [ sh:path arch:export_losses ; sh:datatype xsd:string ; rdfs:comment "export 1." ] ;
  sh:property [ sh:path arch:export_options ; sh:maxCount 1 ; sh:datatype rdf:JSON ; rdfs:comment "export 1." ] ;
  sh:property [ sh:path arch:export_software ; sh:nodeKind sh:IRI ; rdfs:comment "export 1." ] ;
  sh:property [ sh:path arch:exporter ; sh:nodeKind sh:IRI ; rdfs:comment "export 1." ] ;
  sh:property [ sh:path arch:external_entry ; sh:nodeKind sh:IRI ; rdfs:comment "catalogue_correspondence 1." ] ;
  sh:property [ sh:path arch:file_name ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "document_source 1." ] ;
  sh:property [ sh:path arch:form_jumps ; sh:nodeKind sh:IRI ; rdfs:comment "form 1." ] ;
  sh:property [ sh:path arch:form_repeats ; sh:nodeKind sh:IRI ; rdfs:comment "form 1." ] ;
  sh:property [ sh:path arch:form_sections ; sh:nodeKind sh:IRI ; rdfs:comment "form 1." ] ;
  sh:property [ sh:path arch:form_spans ; sh:nodeKind sh:IRI ; rdfs:comment "form_spans 1." ] ;
  sh:property [ sh:path arch:hold_rule ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "key_regions 1, timed_lyrics 1." ] ;
  sh:property [ sh:path arch:joined ; sh:nodeKind sh:IRI ; rdfs:comment "export 1." ] ;
  sh:property [ sh:path arch:jurisdiction ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "rights 1." ] ;
  sh:property [ sh:path arch:key_anchor_form ; sh:nodeKind sh:IRI ; rdfs:comment "key_sequence 1." ] ;
  sh:property [ sh:path arch:key_anchor_sequence ; sh:nodeKind sh:IRI ; rdfs:comment "key_sequence 1." ] ;
  sh:property [ sh:path arch:key_regions ; sh:nodeKind sh:IRI ; rdfs:comment "key_regions 1, key_sequence 1." ] ;
  sh:property [ sh:path arch:laid_on_meter ; sh:nodeKind sh:IRI ; rdfs:comment "melody 1." ] ;
  sh:property [ sh:path arch:lead_sheet_parts ; sh:nodeKind sh:IRI ; rdfs:comment "lead_sheet 1." ] ;
  sh:property [ sh:path arch:licensee ; sh:nodeKind sh:IRI ; rdfs:comment "rights 1." ] ;
  sh:property [ sh:path arch:limit_reason ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "sensitivity 1." ] ;
  sh:property [ sh:path arch:limited_subject ; sh:nodeKind sh:IRI ; rdfs:comment "sensitivity 1." ] ;
  sh:property [ sh:path arch:locator_scheme ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "timed_lyrics 1." ] ;
  sh:property [ sh:path arch:lyric_document ; sh:nodeKind sh:IRI ; rdfs:comment "timed_lyrics 1." ] ;
  sh:property [ sh:path arch:mapped_artist ; sh:nodeKind sh:IRI ; rdfs:comment "catalogue_correspondence 1." ] ;
  sh:property [ sh:path arch:mapping_relation ; sh:nodeKind sh:IRI ; rdfs:comment "catalogue_correspondence 1." ] ;
  sh:property [ sh:path arch:mark_about ; sh:nodeKind sh:IRI ; rdfs:comment "span_annotation 1." ] ;
  sh:property [ sh:path arch:mark_kind ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "span_annotation 1." ] ;
  sh:property [ sh:path arch:mark_text ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "span_annotation 1." ] ;
  sh:property [ sh:path arch:marked_entries ; sh:nodeKind sh:IRI ; rdfs:comment "span_annotation 1." ] ;
  sh:property [ sh:path arch:marked_sequence ; sh:nodeKind sh:IRI ; rdfs:comment "span_annotation 1." ] ;
  sh:property [ sh:path arch:marked_span ; sh:nodeKind sh:IRI ; rdfs:comment "span_annotation 1." ] ;
  sh:property [ sh:path arch:measured_on_tuning ; sh:nodeKind sh:IRI ; rdfs:comment "key_regions 1, notes 1." ] ;
  sh:property [ sh:path arch:measured_stream ; sh:nodeKind sh:IRI ; rdfs:comment "form_spans 1, key_regions 1, melody_spans 1, notes 1, span_annotation 1, timed_lyrics 1, tuning 1." ] ;
  sh:property [ sh:path arch:media ; sh:nodeKind sh:IRI ; rdfs:comment "tracklist 1." ] ;
  sh:property [ sh:path arch:media_type ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "document_source 1, export 1." ] ;
  sh:property [ sh:path arch:medium_position ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "recording_audio 1." ] ;
  sh:property [ sh:path arch:melody_items ; sh:nodeKind sh:IRI ; rdfs:comment "melody 1." ] ;
  sh:property [ sh:path arch:melody_spans ; sh:nodeKind sh:IRI ; rdfs:comment "melody_spans 1." ] ;
  sh:property [ sh:path arch:melody_start ; sh:nodeKind sh:IRI ; rdfs:comment "melody 1." ] ;
  sh:property [ sh:path arch:note_events ; sh:nodeKind sh:IRI ; rdfs:comment "notes 1." ] ;
  sh:property [ sh:path arch:notes_range ; sh:nodeKind sh:IRI ; rdfs:comment "notes 1." ] ;
  sh:property [ sh:path arch:open_strings ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "notes 1." ] ;
  sh:property [ sh:path arch:part ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "key_regions 1, key_sequence 1, melody 1, notes 1." ] ;
  sh:property [ sh:path arch:part_contribution ; sh:nodeKind sh:IRI ; rdfs:comment "notes 1." ] ;
  sh:property [ sh:path arch:partial_tracklist ; sh:maxCount 1 ; sh:datatype xsd:boolean ; rdfs:comment "tracklist 1." ] ;
  sh:property [ sh:path arch:placed_by_tracklist ; sh:nodeKind sh:IRI ; rdfs:comment "recording_audio 1." ] ;
  sh:property [ sh:path arch:placed_form ; sh:nodeKind sh:IRI ; rdfs:comment "form_spans 1." ] ;
  sh:property [ sh:path arch:placed_key_sequence ; sh:nodeKind sh:IRI ; rdfs:comment "key_regions 1." ] ;
  sh:property [ sh:path arch:recording_audio ; sh:nodeKind sh:IRI ; rdfs:comment "recording_audio 1." ] ;
  sh:property [ sh:path arch:reference_cents ; sh:maxCount 1 ; sh:datatype xsd:decimal ; rdfs:comment "tuning 1." ] ;
  sh:property [ sh:path arch:rendered ; sh:nodeKind sh:IRI ; rdfs:comment "export 1." ] ;
  sh:property [ sh:path arch:retrieved_at ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "catalogue_correspondence 1, document_source 1, recording_audio 1, rights 1, tracklist 1." ] ;
  sh:property [ sh:path arch:retrieved_from ; sh:maxCount 1 ; sh:datatype xsd:anyURI ; rdfs:comment "document_source 1." ] ;
  sh:property [ sh:path arch:rights_from ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "rights 1." ] ;
  sh:property [ sh:path arch:rights_holder ; sh:nodeKind sh:IRI ; rdfs:comment "rights 1." ] ;
  sh:property [ sh:path arch:rights_statement ; sh:nodeKind sh:IRI ; rdfs:comment "rights 1." ] ;
  sh:property [ sh:path arch:rights_subject ; sh:nodeKind sh:IRI ; rdfs:comment "rights 1." ] ;
  sh:property [ sh:path arch:rights_text ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "rights 1." ] ;
  sh:property [ sh:path arch:rights_until ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "rights 1." ] ;
  sh:property [ sh:path arch:sample_rate ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "form_spans 1, key_regions 1, melody_spans 1, notes 1, span_annotation 1, timed_lyrics 1, tuning 1." ] ;
  sh:property [ sh:path arch:timed_lines ; sh:nodeKind sh:IRI ; rdfs:comment "timed_lyrics 1." ] ;
  sh:property [ sh:path arch:tlp_label ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "sensitivity 1." ] ;
  sh:property [ sh:path arch:track_position ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "recording_audio 1." ] ;
  sh:property [ sh:path arch:track_recording ; sh:nodeKind sh:IRI ; rdfs:comment "tracklist 1." ] ;
  sh:property [ sh:path arch:tune_notes ; sh:nodeKind sh:IRI ; rdfs:comment "melody_spans 1." ] ;
  sh:property [ sh:path arch:tuning_drift ; sh:nodeKind sh:IRI ; rdfs:comment "tuning 1." ] ;
  sh:property [ sh:path arch:unpitched ; sh:maxCount 1 ; sh:datatype xsd:boolean ; rdfs:comment "notes 1." ] ;
  sh:property [ sh:path arch:weight_scale ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "key_regions 1, key_sequence 1." ] ;
  sh:property [ sh:path arch:work_origin ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "work_origin 1." ] ;
  sh:property [ sh:path arch:writer ; sh:nodeKind sh:IRI ; rdfs:comment "work_origin 1." ] ;
  sh:property [ sh:path arch:written_in_band ; sh:nodeKind sh:IRI ; rdfs:comment "work_origin 1." ] .

wsh:BankStem a sh:NodeShape ;
  rdfs:comment "A stem cited by bank key (ADR 0079), <{owner}:stem>: one regenerable bank file, never an Artifact." ;
  sh:targetObjectsOf arch:bank_stem ;
  sh:closed true ;
  sh:property [ sh:path arch:bank_extractor ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:bank_file_digest ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:bank_key ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:bank_output ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:BarChords a sh:NodeShape ;
  rdfs:comment "meter_layers 2: a chord a written bar holds, <{bar}:chord={n}>: the pinned sequence's entry, and where in the bar it starts." ;
  sh:targetObjectsOf arch:bar_chords ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:bar_offset ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:sequence_entry ] .

wsh:BarOffset a sh:NodeShape ;
  rdfs:comment "Where in a bar something starts, a written length: count units of 1/unit of a whole note." ;
  sh:targetObjectsOf arch:bar_offset ;
  sh:closed true ;
  sh:property [ sh:path arch:note_count ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:note_unit ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:ExportSoftware a sh:NodeShape ;
  rdfs:comment "export 1: one program the exporter reports, <{revision}:software={n}>; rdf:value is its reported position from 0." ;
  sh:targetObjectsOf arch:export_software ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path foaf:name ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:version ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:Exporter a sh:NodeShape ;
  rdfs:comment "export 1: the exporter, <{revision}:exporter>, its identifier and version." ;
  sh:targetObjectsOf arch:exporter ;
  sh:closed true ;
  sh:property [ sh:path dcterms:identifier ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:version ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:FormJumps a sh:NodeShape ;
  rdfs:comment "form 1: one jump, <{revision}:jump={n}>, taken after a section to the start (da capo) or a section (dal segno), and how its return ends. Sections are nodes of the same form." ;
  sh:targetObjectsOf arch:form_jumps ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:coda_from ] ;
  sh:property [ sh:path arch:coda_section ] ;
  sh:property [ sh:path arch:fine_section ] ;
  sh:property [ sh:path arch:jump_after ] ;
  sh:property [ sh:path arch:jump_kind ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:jump_then ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:jump_to ] ;
  sh:property [ sh:path arch:repeats_on_return ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

wsh:FormRepeats a sh:NodeShape ;
  rdfs:comment "form 1: one repeated range of sections, <{revision}:repeat={n}>, with its endings; the played order is a view." ;
  sh:targetObjectsOf arch:form_repeats ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:first_section ] ;
  sh:property [ sh:path arch:last_section ] ;
  sh:property [ sh:path arch:repeat_endings ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:times ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:FormSections a sh:NodeShape ;
  rdfs:comment "form 1: one section, <{revision}:section={n}>; rdf:value is its written position from 0." ;
  sh:targetObjectsOf arch:form_sections ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path rdfs:label ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:locator ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:section_kind ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:FormSpan a sh:NodeShape ;
  rdfs:comment "form_spans 1: one span of samples, <{revision}:span={n}>, and the section of the pinned form it plays, or its own label and kind." ;
  sh:targetObjectsOf arch:form_spans ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path rdfs:label ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:end_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:form_section ] ;
  sh:property [ sh:path arch:locator ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:section_kind ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:JudgedEntries a sh:NodeShape ;
  rdfs:comment "judgment 2: the judged chord sequence's entries, from first to last, as nodes of that sequence's graph." ;
  sh:targetObjectsOf arch:judged_entries ;
  sh:closed true ;
  sh:property [ sh:path arch:first_entry ] ;
  sh:property [ sh:path arch:last_entry ] .

wsh:JudgedReading a sh:NodeShape ;
  rdfs:comment "judgment 2: one reading judged: the span or entry it is in, and its index." ;
  sh:targetObjectsOf arch:judged_reading ;
  sh:closed true ;
  sh:property [ sh:path arch:judged_entry ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:judged_reading ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:judged_span ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:JudgedSpan a sh:NodeShape ;
  rdfs:comment "judgment 2: the samples judged." ;
  sh:targetObjectsOf arch:judged_span ;
  sh:closed true ;
  sh:property [ sh:path arch:end_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:KeyReadings a sh:NodeShape ;
  rdfs:comment "One key reading, ranked: rdf:value is its rank in the asserter's order from 0. A key has a collection, and optionally a tonic, a mode, and its own spelling; no key has arch:no_key; a text-only reading has only its text." ;
  sh:targetObjectsOf arch:key_readings ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:mode_name ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:no_key ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path arch:pitch_collection ; sh:maxCount 12 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:source_text ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:spelling ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:tonic ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:weight ; sh:maxCount 1 ; sh:datatype xsd:decimal ] .

wsh:KeyRegion a sh:NodeShape ;
  rdfs:comment "key_sequence 1 or key_regions 1: one region, <{revision}:region={n}>: over entries or sections of the pinned anchor, or over samples." ;
  sh:targetObjectsOf arch:key_regions ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:end_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:first_position ] ;
  sh:property [ sh:path arch:key_readings ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:last_position ] ;
  sh:property [ sh:path arch:locator ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:section ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:sequence_region ] ;
  sh:property [ sh:path arch:span_end ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:LeadSheetParts a sh:NodeShape ;
  rdfs:comment "lead_sheet 1: one part, <{revision}:part={n}>, its name, instrument, tuning, capo, and the document it was read from." ;
  sh:targetObjectsOf arch:lead_sheet_parts ;
  sh:closed true ;
  sh:property [ sh:path dcterms:source ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:capo_fret ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:instrument ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:open_strings ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:part_name ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:ListedTracks a sh:NodeShape ;
  rdfs:comment "tracklist 1: one track of a medium, <{medium}:track={n}>, as printed." ;
  sh:targetObjectsOf arch:listed_tracks ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:length_ms ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:position ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:printed_artist ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:printed_title ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:track_number_text ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:MarkedEntries a sh:NodeShape ;
  rdfs:comment "span_annotation 1: the marked chord sequence's entries, from first to last." ;
  sh:targetObjectsOf arch:marked_entries ;
  sh:closed true ;
  sh:property [ sh:path arch:first_entry ] ;
  sh:property [ sh:path arch:last_entry ] .

wsh:MarkedSpan a sh:NodeShape ;
  rdfs:comment "span_annotation 1: the samples marked." ;
  sh:targetObjectsOf arch:marked_span ;
  sh:closed true ;
  sh:property [ sh:path arch:end_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:Media a sh:NodeShape ;
  rdfs:comment "tracklist 1: one medium, <{revision}:medium={n}>, with its tracks." ;
  sh:targetObjectsOf arch:media ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:listed_tracks ; sh:nodeKind sh:IRI ] ;
