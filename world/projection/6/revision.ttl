  sh:property [ sh:path arch:timed_words ; sh:nodeKind sh:IRI ] .

wsh:TimedWords a sh:NodeShape ;
  rdfs:comment "timed_lyrics 1: one word of a line at samples, by its number in the line." ;
  sh:targetObjectsOf arch:timed_words ;
  sh:closed true ;
