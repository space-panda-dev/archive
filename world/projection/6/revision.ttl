  sh:property [ sh:path arch:position ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:printed_title ; sh:maxCount 1 ; sh:datatype xsd:string ] .

wsh:MelodyItems a sh:NodeShape ;
  rdfs:comment "melody 1: one note or rest, <{revision}:note={n}>, with its written length; rdf:value is its position from 0." ;
  sh:targetObjectsOf arch:melody_items ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:locator ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:midi_pitch ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:rest ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path arch:written_duration ; sh:nodeKind sh:IRI ] .

wsh:MelodySpan a sh:NodeShape ;
  rdfs:comment "melody_spans 1: one span, <{revision}:span={n}>, selecting the notes of one pinned notes claim." ;
  sh:targetObjectsOf arch:melody_spans ;
  sh:closed true ;
  sh:property [ sh:path rdf:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:end_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:note_selection ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:tune_notes ; sh:nodeKind sh:IRI ] .

wsh:MelodyStart a sh:NodeShape ;
  rdfs:comment "melody 1: where the tune starts in its meter: a layer, a bar, and an offset." ;
  sh:targetObjectsOf arch:melody_start ;
  sh:closed true ;
  sh:property [ sh:path arch:bar_index ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:bar_offset ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:meter_layer_index ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:NoteEvents a sh:NodeShape ;
  rdfs:comment "notes 1: one sounded note, <{revision}:note={n}>, its samples and pitch, and where a document writes it." ;
  sh:targetObjectsOf arch:note_events ;
