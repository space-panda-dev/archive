  sh:property [ sh:path arch:locator ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path arch:midi_pitch ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:offset_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:onset_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:pitch_cents ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path arch:velocity ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:NotesRange a sh:NodeShape ;
  rdfs:comment "notes 1: the samples the claim speaks for; outside them it says nothing." ;
  sh:targetObjectsOf arch:notes_range ;
  sh:closed true ;
  sh:property [ sh:path arch:end_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

wsh:RepeatEndings a sh:NodeShape ;
  rdfs:comment "form 1: one ending of a repeat, the sections it covers and the passes that take it." ;
  sh:targetObjectsOf arch:repeat_endings ;
  sh:closed true ;
