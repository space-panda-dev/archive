  sh:property [ sh:path arch:drift_cents ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path arch:end_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:start_sample ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

