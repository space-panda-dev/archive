  sh:property [ sh:path arch:ending_passes ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path arch:first_section ] ;
  sh:property [ sh:path arch:last_section ] .

wsh:TimedLines a sh:NodeShape ;
  rdfs:comment "timed_lyrics 1: one line of the lyric document at samples; its words stay in the document." ;
  sh:targetObjectsOf arch:timed_lines ;
  sh:closed true ;
