cabal-version: 3.0
name: archive
version: 0.0.1.0
build-type: Simple
license: AGPL-3.0-or-later
data-files:
    spec/VERSION
  , spec/archive-spec.md
  , spec/0.0.1/context.jsonld
  , spec/0.0.2/context.jsonld
  , spec/0.0.3/context.jsonld
  , spec/0.0.4/context.jsonld
  , spec/0.0.5/context.jsonld
  , spec/0.0.6/context.jsonld
  , spec/0.0.7/context.jsonld
  , spec/0.0.8/context.jsonld
  , spec/0.0.9/context.jsonld
  , spec/0.0.10/context.jsonld
  , spec/0.0.11/context.jsonld
  , spec/0.0.1/contracts.json
  , spec/0.0.2/contracts.json
  , spec/0.0.3/contracts.json
  , spec/0.0.4/contracts.json
  , spec/0.0.5/contracts.json
  , spec/0.0.6/contracts.json
  , spec/0.0.7/contracts.json
  , spec/0.0.8/contracts.json
  , spec/0.0.9/contracts.json
  , spec/0.0.10/contracts.json
  , spec/0.0.11/contracts.json
  , spec/contracts/*.json

library
  c-sources: door/src/Archive/ProcessPinned.c
  autogen-modules: Paths_archive
  -- The writer's parts stay private: RecordCommit exports ArchiveWriteLock
  -- abstractly, and only these modules may see its constructor.
  other-modules:
      Paths_archive
    , Archive.Door.RecordCommit.Descriptors
    , Archive.Door.RecordCommit.Durability
    , Archive.Door.RecordCommit.Failure
    , Archive.Door.RecordCommit.Git
    , Archive.Door.RecordCommit.IndexReservation
    , Archive.Door.RecordCommit.Internal
    , Archive.Door.RecordCommit.Journal
    , Archive.Door.RecordCommit.Lock
    , Archive.Door.RecordCommit.Maintenance
    , Archive.Door.RecordCommit.ObjectName
    , Archive.Door.RecordCommit.Paths
    , Archive.Door.RecordCommit.Records
    , Archive.Door.RecordCommit.Recovery
    , Archive.Door.RecordCommit.Worktree
  exposed-modules:
      Archive.Door.AdmissionDryRun
    , Archive.Door.AdmissionCommit
    , Archive.Door.AdmissionPlan
    , Archive.Door.Canonical
    , Archive.Door.Catalog
    , Archive.Door.ContractCitations
    , Archive.Door.Bootstrap
    , Archive.Door.Bootstrap.Abort
    , Archive.Door.Bootstrap.Contents
    , Archive.Door.Bootstrap.Git
    , Archive.Door.Bootstrap.Journal
    , Archive.Door.Bootstrap.Pinned
    , Archive.Door.Bootstrap.Tracked
    , Archive.Door.Bootstrap.Verify
    , Archive.Door.Contracts
    , Archive.Door.Contracts.Context
    , Archive.Door.Contracts.Evaluate
    , Archive.Door.Contracts.Fields
    , Archive.Door.Contracts.Pattern
    , Archive.Door.Contracts.Pointer
    , Archive.Door.Contracts.Profile
    , Archive.Door.Contracts.Profile.Arrays
    , Archive.Door.Contracts.Profile.Error
    , Archive.Door.Contracts.Profile.Music
    , Archive.Door.Contracts.Profile.Paths
    , Archive.Door.Contracts.Profile.Payload
    , Archive.Door.Contracts.Profile.PinnedTargets
    , Archive.Door.Contracts.Profile.ReferenceTargets
    , Archive.Door.Contracts.Profile.Refs
    , Archive.Door.Contracts.Profile.Spans
    , Archive.Door.Contracts.Profile.Syntax
    , Archive.Door.Contracts.Schema
    , Archive.Door.Contracts.SchemaError
    , Archive.Door.Hex
    , Archive.Door.IOFailure
    , Archive.Door.Identity
    , Archive.Door.Json
    , Archive.Door.Json.Access
    , Archive.Door.Layout
    , Archive.Door.MutationError
    , Archive.Door.AgentRules
    , Archive.Door.BeyondCircle
    , Archive.Door.Reach
    , Archive.Door.SharingGate
    , Archive.Door.SpanRules
    , Archive.Door.FormStructure
    , Archive.Door.JudgedScope
    , Archive.Door.PinnedRules
    , Archive.Door.PlacedItems
    , Archive.Door.RecordRules
    , Archive.Door.ReleaseAdmission
    , Archive.Door.RuleJson
    , Archive.Door.RuleRecords
    , Archive.Door.RuleSyntax
    , Archive.Door.WhenPinned
    , Archive.Door.WrittenBars
    , Archive.Door.Proposal
    , Archive.Door.ProposalContracts
    , Archive.Door.ProposalProblem
    , Archive.Door.RecordCommit
    -- The journal's pure encoding is exposed for door-test's properties; it
    -- builds and parses bytes only and carries no write capability.
    , Archive.Door.RecordCommit.JournalFormat
    , Archive.Door.SchemaObjectKeywords
    , Archive.Door.SpecificationUpgrade
    , Archive.Door.Snapshot.Data
    , Archive.Door.Snapshot.History
    , Archive.Door.Snapshot.Load
    , Archive.Door.Snapshot.Memo
    , Archive.Door.Snapshot.Read
    , Archive.Door.Snapshot.Supersession
    , Archive.Door.References
    , Archive.Door.ReferenceTargets
    , Archive.Door.PlanProblem
    , Archive.Door.Refusal
    , Archive.Door.TransitionDryRun
    , Archive.Door.TransitionCommit
    , Archive.Door.TargetMeasures
    , Archive.Door.Transition.Dispatch
    , Archive.Door.Transition.Plan
    , Archive.Door.Transition.Problem
    , Archive.Door.Transition.Replay
    , Archive.Door.Transition.Rules
    , Archive.Door.Transition.Upgrade
    , Archive.Door.Types
    , Archive.Door.VerifiedCheckpoint
    , Archive.Process
    , Archive.Executables
    , Archive.Doctor.Checks
    , Archive.GitSnapshot
    , Archive.Read.Core
  hs-source-dirs: door/src
  build-depends:
      aeson >=2.2.1 && <2.4
    , base >=4.19 && <5
    , bytestring
    , cryptohash-sha256
    , containers
    , directory
    , filepath
    , process
    , scientific
    , text
    , time
    , transformers
    , unix
    , vector
    , zlib
    , cryptohash-sha1
  default-language: GHC2021
  ghc-options: -Wall -Werror

executable door
  main-is: Main.hs
  hs-source-dirs: door/app
  build-depends:
      aeson >=2.2.1 && <2.4
    , archive
    , base >=4.19 && <5
    , bytestring
    , directory
    , filepath
    , network
    , text
    , unix
  default-language: GHC2021
  ghc-options: -Wall -Werror

executable archive
  main-is: Main.hs
  hs-source-dirs: archive/app
  build-depends:
      aeson >=2.2.1 && <2.4
    , archive
    , base >=4.19 && <5
    , bytestring
    , containers
    , text
  default-language: GHC2021
  ghc-options: -Wall -Werror

test-suite door-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      AdmissionChecks
    , BeyondCircle010
    , BootstrapChecks
    , CanonicalProperties
    , CheckpointChecks
    , ContractAdmissionChecks
    , ContractChecks
    , EnvelopeChecks
    , Fixtures
    , GitSnapshotChecks
    , GitStoreChecks
    , HexProperties
    , IdentityVectors
    , JournalProperties
    , JournalRecoveryChecks
    , PatternProperties
    , PointerProperties
    , RecordCommitChecks
    , Rfc8785Vectors
    , Rules010
    , Rules011
    , ServiceChecks
    , Specification010
    , Specification011
    , SubprocessChecks
    , Support
    , TransitionChecks
    , UpgradeChecks
  hs-source-dirs: door/test
  build-tool-depends:
      archive:archive
    , archive:door
  build-depends:
      aeson >=2.2.1 && <2.4
    , archive
    , base >=4.19 && <5
    , bytestring
    , containers
    , cryptohash-sha256
    , directory
    , network
    , process
    , QuickCheck
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , time
    , unix
    , vector
  default-language: GHC2021
  ghc-options: -Wall -Werror

test-suite archive-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      ExportChecks
    , IncompleteChecks
    , MaintenanceChecks
    , ReaderChecks
    , Support
  hs-source-dirs: archive/test
  build-tool-depends:
      archive:archive
    , archive:door
  build-depends:
      aeson >=2.2.1 && <2.4
    , archive
    , base >=4.19 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , process
    , tasty
    , tasty-hunit
    , text
  default-language: GHC2021
  ghc-options: -Wall -Werror
