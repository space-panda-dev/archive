cabal-version: 3.0
name: archive
version: 0.0.1.0
build-type: Simple
license: AGPL-3.0-or-later
data-files:
    spec/VERSION
  , spec/archive-spec.md
  , spec/0.0.1/context.jsonld
  , spec/0.0.2/context.jsonld
  , spec/0.0.3/context.jsonld
  , spec/0.0.4/context.jsonld
  , spec/0.0.5/context.jsonld
  , spec/0.0.6/context.jsonld
  , spec/0.0.7/context.jsonld
  , spec/0.0.8/context.jsonld
  , spec/0.0.9/context.jsonld
  , spec/0.0.10/context.jsonld
  , spec/0.0.11/context.jsonld
  , spec/0.0.1/contracts.json
  , spec/0.0.2/contracts.json
  , spec/0.0.3/contracts.json
  , spec/0.0.4/contracts.json
  , spec/0.0.5/contracts.json
  , spec/0.0.6/contracts.json
  , spec/0.0.7/contracts.json
  , spec/0.0.8/contracts.json
  , spec/0.0.9/contracts.json
  , spec/0.0.10/contracts.json
  , spec/0.0.11/contracts.json
  , spec/contracts/*.json

library
  c-sources: door/src/Archive/ProcessPinned.c
  autogen-modules: Paths_archive
  -- The writer's parts stay private: RecordCommit exports ArchiveWriteLock
  -- abstractly, and only these modules may see its constructor.
  other-modules:
      Paths_archive
    , Archive.Door.RecordCommit.Descriptors
    , Archive.Door.RecordCommit.Durability
    , Archive.Door.RecordCommit.Failure
    , Archive.Door.RecordCommit.Git
    , Archive.Door.RecordCommit.IndexReservation
    , Archive.Door.RecordCommit.Internal
    , Archive.Door.RecordCommit.Journal
    , Archive.Door.RecordCommit.Lock
    , Archive.Door.RecordCommit.Maintenance
    , Archive.Door.RecordCommit.Paths
    , Archive.Door.RecordCommit.Records
    , Archive.Door.RecordCommit.Recovery
    , Archive.Door.RecordCommit.Worktree
  exposed-modules:
      Archive.Door.AdmissionDryRun
    , Archive.Door.AdmissionCommit
    , Archive.Door.AdmissionPlan
    , Archive.Door.Canonical
    , Archive.Door.Catalog
    , Archive.Door.Bootstrap
    , Archive.Door.Contracts
    , Archive.Door.Hex
    , Archive.Door.Identity
    , Archive.Door.Json
    , Archive.Door.Json.Access
    , Archive.Door.Layout
    , Archive.Door.MutationError
    , Archive.Door.AgentRules
    , Archive.Door.BeyondCircle
    , Archive.Door.Reach
    , Archive.Door.SharingGate
    , Archive.Door.SpanRules
    , Archive.Door.FormStructure
    , Archive.Door.JudgedScope
    , Archive.Door.PinnedRules
    , Archive.Door.PlacedItems
    , Archive.Door.RecordRules
    , Archive.Door.ReleaseAdmission
    , Archive.Door.RuleJson
    , Archive.Door.RuleRecords
    , Archive.Door.RuleSyntax
    , Archive.Door.WhenPinned
    , Archive.Door.WrittenBars
    , Archive.Door.Proposal
    , Archive.Door.RecordCommit
    , Archive.Door.SchemaObjectKeywords
    , Archive.Door.SpecificationUpgrade
    , Archive.Door.References
    , Archive.Door.Refusal
    , Archive.Door.TransitionDryRun
    , Archive.Door.TransitionCommit
    , Archive.Door.Types
    , Archive.Door.VerifiedCheckpoint
    , Archive.Process
    , Archive.Executables
    , Archive.Doctor.Checks
    , Archive.GitSnapshot
    , Archive.Read.Core
  hs-source-dirs: door/src
  build-depends:
      aeson >=2.2.1 && <2.4
    , base >=4.18 && <5
    , bytestring
    , cryptohash-sha256
    , containers
    , directory
    , filepath
    , process
    , scientific
    , text
    , time
    , transformers
    , unix
    , vector
    , zlib
    , cryptohash-sha1
  default-language: GHC2021
  ghc-options: -Wall -Werror

executable door
  main-is: Main.hs
  hs-source-dirs: door/app
  build-depends:
      aeson >=2.2.1 && <2.4
    , archive
    , base >=4.18 && <5
    , bytestring
    , directory
    , filepath
    , network
    , text
    , unix
  default-language: GHC2021
  ghc-options: -Wall -Werror

executable archive
  main-is: Main.hs
  hs-source-dirs: archive/app
  build-depends:
      aeson >=2.2.1 && <2.4
    , archive
    , base >=4.18 && <5
    , bytestring
    , containers
    , text
  default-language: GHC2021
  ghc-options: -Wall -Werror

test-suite door-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules: BeyondCircle010, IdentityVectors, Rules010, Rules011, Specification010, Specification011
  hs-source-dirs: door/test
  build-tool-depends:
      archive:archive
    , archive:door
  build-depends:
      aeson >=2.2.1 && <2.4
    , archive
    , base >=4.18 && <5
    , bytestring
    , containers
    , cryptohash-sha256
    , directory
    , network
    , process
    , text
    , time
    , unix
    , vector
  default-language: GHC2021
  ghc-options: -Wall -Werror

test-suite archive-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: archive/test
  build-tool-depends:
      archive:archive
    , archive:door
  build-depends:
      aeson >=2.2.1 && <2.4
    , archive
    , base >=4.18 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , process
    , text
  default-language: GHC2021
  ghc-options: -Wall -Werror
